{
    "name": "$VENDOR$/$KEBAB_NAME$",
    "description": "Chabok module using the approved layered structure.",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "$MODULE_NAMESPACE$\\$STUDLY_NAME$\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "$MODULE_NAMESPACE$\\$STUDLY_NAME$\\Tests\\": "tests/"
        }
    }
}
